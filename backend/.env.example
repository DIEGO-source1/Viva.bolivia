# Variables de entorno (en Vercel: Project → Settings → Environment Variables)
# NO subas valores reales a GitHub.

# Neon Console → tu proyecto → Connect → Connection string (pooled)
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# console.anthropic.com → API Keys (empieza con sk-ant-)
IA_API_KEY=

# Opcionales
IA_MODELO=claude-haiku-5-5
IA_MODELO_VISION=
CORS_ORIGIN=*
