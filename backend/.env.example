# Copy to .env for local development. Never commit .env or real secrets.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/DBNAME?sslmode=require

# Optional: only needed when Gemini API access is available and intentionally enabled.
GEMINI_API_KEY=
IA_MODELO=gemini-2.5-flash-lite
IA_MODELO_VISION=gemini-2.5-flash-lite

# Exact deployed frontend origin; localhost for local development.
CORS_ORIGIN=http://localhost:4200
