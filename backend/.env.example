# Copy to .env for local development. Never commit .env or real secrets.
# Runtime/serverless connection: use Neon pooled URL (hostname contains -pooler).
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Optional direct connection for migration tooling only (not used by app runtime).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/DBNAME?sslmode=require

# Anthropic Console → API Keys. Keep this only in backend/Vercel environment variables.
IA_API_KEY=
# Valid Anthropic API model alias; can be overridden in Vercel.
IA_MODELO=claude-haiku-5-5
IA_MODELO_VISION=claude-haiku-5-5

# Exact deployed frontend origin in production; localhost for local development.
CORS_ORIGIN=http://localhost:4200
