# Local development. Never commit real .env values.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
CORS_ORIGIN=http://localhost:4200

# Set a long random secret only temporarily for the one-time admin bootstrap.
# Remove it from Vercel immediately after creating the admin account.
ADMIN_BOOTSTRAP_SECRET=

# Optional AI provider; no key is needed for deterministic route planning.
GEMINI_API_KEY=
IA_MODELO=gemini-2.5-flash-lite
IA_MODELO_VISION=gemini-2.5-flash-lite

# Credenciales iniciales del único administrador.
# Copia este archivo a .env, completa estos valores y NO subas .env a GitHub.
ADMIN_NAME=Administrador Bolivia Viva
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=CAMBIA-ESTA-POR-UNA-CONTRASENA-LARGA-Y-UNICA
